PORT=3000

# Optional local JSON metadata directory. Defaults to backend/data.
DATA_DIR=

# Optional in local development. If omitted, uploads are written to backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional local depth camera capture settings.
PYTHON_BIN=python
DEPTH_CAMERA_CAPTURE_TIMEOUT_MS=30000
